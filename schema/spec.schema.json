{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/sajjadriaj/proof/main/schema/spec.schema.json",
  "title": "proof acceptance contract",
  "description": "The definition of \"done\" for one requirement. `proof check` is what decides whether a contract is valid — this schema is for editor completion, and cannot express every rule the validator enforces.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "goal",
    "checks"
  ],
  "properties": {
    "goal": {
      "type": "string",
      "description": "The requirement these checks are meant to prove. A verdict means nothing without it."
    },
    "requirement": {
      "type": "string"
    },
    "criteria": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[A-Za-z][A-Za-z0-9_.-]*$",
            "description": "How checks refer to this criterion in `satisfies`, and how coverage reports it."
          },
          "requirement": {
            "type": "string"
          },
          "source": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "type": {},
                  "reference": {
                    "type": "string"
                  }
                }
              }
            ],
            "description": "Where this criterion came from — text, or {type, reference}."
          },
          "attack": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "surfaces": {
                "type": "array",
                "items": {
                  "enum": [
                    "input",
                    "sequence",
                    "concurrency"
                  ]
                },
                "description": "Which strategies may run: input, sequence, concurrency."
              },
              "budget": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "duration": {
                    "type": "number",
                    "exclusiveMinimum": 0,
                    "description": "Seconds one criterion's search may take."
                  },
                  "candidates": {
                    "type": "number",
                    "exclusiveMinimum": 0,
                    "description": "How many scenarios one criterion's search may evaluate."
                  },
                  "concurrency": {
                    "type": "number",
                    "exclusiveMinimum": 0,
                    "description": "The widest parallel step a concurrency attack builds."
                  }
                }
              },
              "permissions": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "network": {
                    "enum": [
                      "same-origin",
                      "any"
                    ]
                  },
                  "environment_mutation": {
                    "type": "boolean"
                  }
                }
              },
              "setup": {
                "type": "array",
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "properties": {
                    "name": {
                      "type": "string"
                    },
                    "http": {
                      "type": "object",
                      "additionalProperties": false,
                      "properties": {
                        "method": {
                          "type": "string"
                        },
                        "path": {
                          "type": "string"
                        },
                        "url": {
                          "type": "string"
                        },
                        "headers": {
                          "type": "object"
                        },
                        "body": {},
                        "expect": {},
                        "follow_redirects": {
                          "type": "boolean"
                        },
                        "concurrent": {}
                      }
                    },
                    "run": {
                      "type": "string"
                    },
                    "capture": {
                      "type": "object",
                      "description": "Values later checks use as ${name}. Selectors: json.<path>, header.<name>, status, output, match:<regex>",
                      "additionalProperties": {
                        "type": "string",
                        "minLength": 1
                      },
                      "propertyNames": {
                        "pattern": "^[A-Za-z_][A-Za-z0-9_]*$"
                      }
                    },
                    "timeout": {
                      "type": "number",
                      "exclusiveMinimum": 0
                    }
                  }
                }
              },
              "actions": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "properties": {
                    "name": {
                      "type": "string"
                    },
                    "http": {
                      "type": "object",
                      "additionalProperties": false,
                      "properties": {
                        "method": {
                          "type": "string"
                        },
                        "path": {
                          "type": "string"
                        },
                        "url": {
                          "type": "string"
                        },
                        "headers": {
                          "type": "object"
                        },
                        "body": {},
                        "expect": {},
                        "follow_redirects": {
                          "type": "boolean"
                        },
                        "concurrent": {}
                      }
                    },
                    "run": {
                      "type": "string"
                    },
                    "capture": {
                      "type": "object",
                      "description": "Values later checks use as ${name}. Selectors: json.<path>, header.<name>, status, output, match:<regex>",
                      "additionalProperties": {
                        "type": "string",
                        "minLength": 1
                      },
                      "propertyNames": {
                        "pattern": "^[A-Za-z_][A-Za-z0-9_]*$"
                      }
                    },
                    "timeout": {
                      "type": "number",
                      "exclusiveMinimum": 0
                    }
                  }
                },
                "description": "The operations an attack composes. Named, because invariants count them by name."
              },
              "invariants": {
                "type": "array",
                "minItems": 1,
                "description": "What must remain true — one comparison each, like `successful_redeem <= 1`.",
                "items": {
                  "anyOf": [
                    {
                      "type": "string",
                      "minLength": 1
                    },
                    {
                      "type": "object",
                      "properties": {
                        "expression": {
                          "type": "string"
                        }
                      },
                      "required": [
                        "expression"
                      ]
                    }
                  ]
                }
              }
            },
            "required": [
              "actions",
              "invariants"
            ],
            "description": "What `proof attack` may manipulate, and what must remain true while it does."
          }
        },
        "required": [
          "id",
          "requirement"
        ]
      },
      "description": "The statements this change has to satisfy. One with no check pointing at it makes a run INCOMPLETE."
    },
    "policy": {
      "type": "object",
      "additionalProperties": false,
      "description": "How much evidence `proof done` requires before it will say DONE.",
      "properties": {
        "require_criteria_coverage": {
          "type": "boolean"
        },
        "require_criteria_falsification": {
          "type": "boolean"
        },
        "require_falsification": {
          "type": "boolean"
        },
        "require_sealed_contract": {
          "type": "boolean"
        },
        "require_challenges": {
          "type": "boolean"
        },
        "allow_flakes": {
          "type": "boolean"
        },
        "allow_skipped": {
          "type": "boolean"
        }
      }
    },
    "challenges": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "name": {
            "type": "string"
          },
          "apply": {
            "type": "string",
            "minLength": 1,
            "description": "The command that introduces the fault, run against a throwaway copy of your code."
          },
          "breaks": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "array",
                "items": {
                  "type": "string"
                },
                "minItems": 1
              }
            ],
            "description": "The criteria this fault violates, so a detection can be attributed to a requirement."
          }
        },
        "required": [
          "name",
          "apply"
        ]
      },
      "description": "Faults `proof challenge` injects into a copy of your code. The contract has to fail on each."
    },
    "serve": {
      "description": "The process, or processes in dependency order, to start before the checks.",
      "anyOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "name": {
              "type": "string"
            },
            "run": {
              "type": "string"
            },
            "ready_url": {
              "type": "string",
              "format": "uri",
              "pattern": "^https?://"
            },
            "ready_log": {
              "type": "string",
              "minLength": 1,
              "description": "A regex the process output must match. For an app with no URL to poll."
            },
            "url": {
              "type": "string"
            },
            "timeout": {
              "type": "number",
              "exclusiveMinimum": 0
            },
            "log_must_not_match": {
              "type": "string"
            },
            "reuse_existing": {
              "type": "boolean"
            }
          },
          "required": [
            "run"
          ]
        },
        {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "name": {
                "type": "string"
              },
              "run": {
                "type": "string"
              },
              "ready_url": {
                "type": "string",
                "format": "uri",
                "pattern": "^https?://"
              },
              "ready_log": {
                "type": "string",
                "minLength": 1,
                "description": "A regex the process output must match. For an app with no URL to poll."
              },
              "url": {
                "type": "string"
              },
              "timeout": {
                "type": "number",
                "exclusiveMinimum": 0
              },
              "log_must_not_match": {
                "type": "string"
              },
              "reuse_existing": {
                "type": "boolean"
              }
            },
            "required": [
              "run"
            ]
          },
          "minItems": 1
        }
      ]
    },
    "checks": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "name": {
            "type": "string"
          },
          "satisfies": {
            "description": "The criteria this check is evidence for. A criterion nothing satisfies is uncovered.",
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "array",
                "items": {
                  "type": "string"
                },
                "minItems": 1
              }
            ]
          },
          "timeout": {
            "type": "number",
            "exclusiveMinimum": 0
          },
          "run": {
            "type": "string"
          },
          "http": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "method": {
                "type": "string"
              },
              "path": {
                "type": "string"
              },
              "url": {
                "type": "string"
              },
              "headers": {
                "type": "object"
              },
              "body": {},
              "expect": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "status": {
                    "type": "integer"
                  },
                  "statuses": {},
                  "headers": {
                    "type": "object"
                  },
                  "body_contains": {
                    "type": "string",
                    "minLength": 1
                  },
                  "body_not_contains": {
                    "type": "string",
                    "minLength": 1
                  },
                  "json": {
                    "description": "Subset match. Type tokens: <string>, <number>, <boolean>, <array>, <object>, <null>, <any>"
                  }
                }
              },
              "follow_redirects": {
                "type": "boolean"
              },
              "concurrent": {}
            }
          },
          "file": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "path": {
                    "type": "string"
                  },
                  "exists": {
                    "type": "boolean"
                  },
                  "contains": {
                    "type": "string",
                    "minLength": 1
                  },
                  "not_contains": {
                    "type": "string",
                    "minLength": 1
                  }
                }
              }
            ]
          },
          "env": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "name": {
                    "type": "string"
                  },
                  "matches": {
                    "type": "string",
                    "minLength": 1
                  }
                }
              }
            ]
          },
          "browser": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "visit": {
                "type": "string"
              },
              "flow": {
                "type": "array",
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "properties": {
                    "visit": {
                      "type": "string"
                    },
                    "fill": {
                      "type": "object"
                    },
                    "click": {
                      "type": "string"
                    },
                    "expect_text": {
                      "type": "string",
                      "minLength": 1
                    },
                    "expect_request": {
                      "type": "object",
                      "additionalProperties": false,
                      "properties": {
                        "method": {
                          "type": "string"
                        },
                        "path": {
                          "type": "string"
                        },
                        "path_matches": {
                          "type": "string",
                          "minLength": 1
                        },
                        "url": {
                          "type": "string"
                        },
                        "timeout_ms": {
                          "type": "number",
                          "exclusiveMinimum": 0
                        },
                        "status": {
                          "type": "integer"
                        }
                      }
                    },
                    "expect_url": {
                      "type": "string"
                    },
                    "wait": {
                      "type": "number"
                    }
                  }
                }
              },
              "base_url": {
                "type": "string",
                "pattern": "^https?://"
              },
              "expect_no_console_errors": {
                "type": "boolean"
              }
            }
          },
          "expect_exit": {
            "type": "integer"
          },
          "expect_output": {
            "type": "string",
            "minLength": 1
          },
          "expect_under_ms": {
            "type": "number",
            "exclusiveMinimum": 0,
            "description": "The check's own wall clock, spawn included. One measurement, not a benchmark."
          },
          "retry_for_ms": {},
          "results": {},
          "capture": {
            "type": "object",
            "description": "Values later checks use as ${name}. Selectors: json.<path>, header.<name>, status, output, match:<regex>",
            "additionalProperties": {
              "type": "string",
              "minLength": 1
            },
            "propertyNames": {
              "pattern": "^[A-Za-z_][A-Za-z0-9_]*$"
            }
          },
          "skip": {
            "type": "string",
            "minLength": 1,
            "description": "Why this check is switched off. A run with one cannot report completion."
          },
          "parallel": {
            "type": "boolean",
            "description": "Run alongside the adjacent checks also marked parallel. They must not depend on each other."
          }
        }
      }
    }
  },
  "$comment": "verbs: run, http, file, env, browser; browser step verbs: visit, fill, click, expect_text, expect_request, expect_url, wait"
}
